// zamkonator — config schema

// ── Digital input enums ───────────────────────────────────────────────────────

enum digital_input_mode_t {
    none,
    push_to_exit,
    door_close_sensor,
    door_lock_sensor,
    generic
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum language_t {
    en,
    pl
}

enum mqtt_status_t {
    connected,
    connecting,
    disconnected,
    unconfigured
}

// Response struct for GET /api/info (unauthenticated)
struct web_info_t {
    bool web_password_enabled;
    sstr_t language;
    nullable bool web_password_valid;  // present only when X-Auth header was supplied
}

// ── Config sub-structs ────────────────────────────────────────────────────────

struct digital_input_config_t {
    digital_input_mode_t mode;
    bool inverted;
    int debounce_ms;
}

struct mqtt_config_t {
    bool enabled;
    sstr_t broker;
    int port;
    sstr_t username;
    sstr_t password;
    sstr_t mqtt_prefix;
}

// Top-level persisted config
struct gateway_config_t {
    int version;
    sstr_t hostname;
    mqtt_config_t mqtt;
    bool web_password_enabled;
    sstr_t web_password;   // PBKDF2 hash: base64(16-byte salt) + "$" + base64(32-byte output)
    language_t language;
    sstr_t auth_proxy_base_url;
    int    auth_proxy_timeout_ms;
    int    auth_proxy_healthcheck_interval_ms;
    bool   auth_proxy_cache_enabled;
    int    auth_proxy_cache_refresh_ms;
    int    relay_open_ms;
    digital_input_config_t input_inp1;
    digital_input_config_t input_inp2;
    digital_input_config_t input_inp3;
    sstr_t remote_open_password;
}
